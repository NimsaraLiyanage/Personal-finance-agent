# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Local Docker (npm run db:up), or a Neon/Supabase connection string.
DATABASE_URL="postgresql://pfa:pfa@localhost:5434/pfa"

# ── Session ─────────────────────────────────────────────────────────────────
# Signs the anonymous-user cookie. Any random string, 16+ chars.
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-something-random"

# ── Model ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# The chat/agent model. gpt-5.6-luna is the cost-optimised 5.6 tier
# (~$0.20/M input, ~$1.20/M output, 1.05M context) — verified 2026-08-03.
# Swap to gpt-5.6-sol for the frontier tier.
OPENAI_MODEL="gpt-5.6-luna"

# Reasoning-class models only (gpt-5.x / o-series): minimal | low | medium | high
OPENAI_REASONING_EFFORT="low"
OPENAI_MAX_OUTPUT_TOKENS="2000"

# Point at any OpenAI-compatible endpoint to swap providers wholesale —
# Groq, Together, OpenRouter, a local Ollama/vLLM. Leave unset for OpenAI.
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# ── Voice ───────────────────────────────────────────────────────────────────
# pipeline = STT -> text agent -> TTS (cheap, reuses everything)
# realtime = duplex speech-to-speech (lowest latency, billed per audio minute)
VOICE_PROVIDER="pipeline"

# -- pipeline mode --
OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"
# NOTE: gpt-4o-mini-tts is flagged deprecated in the model list but is still
# the TTS model on offer. Check `GET /v1/models` if speech starts 404ing.
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# TTS voices are a different roster from the Realtime voices — "marin" lives
# on Realtime and may not exist here. alloy/coral are safe.
OPENAI_TTS_VOICE="alloy"
# Hint the language of short utterances; cuts latency and misdetection.
# OPENAI_TRANSCRIBE_LANGUAGE="en"
# Client-side endpointing.
PIPELINE_VAD_SILENCE_MS="1200"
PIPELINE_VAD_THRESHOLD="0.015"

# -- realtime mode --
# Billed per AUDIO token (~$32/M in, ~$64/M out on gpt-realtime-2), so the
# mini tier is the demo default. Use gpt-realtime-2.1 for best turn-taking.
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
REALTIME_VOICE="marin"
REALTIME_NOISE_REDUCTION="near_field"
# Raise silence/threshold if the agent cuts you off mid-sentence or starts
# answering its own echo. These defaults were chosen for that failure, not speed.
REALTIME_VAD_THRESHOLD="0.7"
REALTIME_VAD_SILENCE_MS="1500"
REALTIME_VAD_PREFIX_PADDING_MS="400"

# ── Agent behaviour ─────────────────────────────────────────────────────────
# Messages replayed verbatim each turn.
AGENT_HISTORY_WINDOW="20"
# Uncompressed messages that trigger a rolling-summary pass.
AGENT_SUMMARY_THRESHOLD="30"

# ── Defaults for new users ──────────────────────────────────────────────────
DEFAULT_CURRENCY="LKR"
DEFAULT_TIMEZONE="UTC"
