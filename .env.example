# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Local Docker (npm run db:up), or a Neon/Supabase connection string.
DATABASE_URL="postgresql://pfa:pfa@localhost:5434/pfa"

# ── Auth ────────────────────────────────────────────────────────────────────
# Better Auth signs sessions with this. Any random string, 16+ chars.
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-something-random"

# Where the app is reachable. OAuth callbacks are built from it, so it must
# match the origin the browser actually uses.
BETTER_AUTH_URL="http://localhost:3000"

# Kept only to verify cookies issued before Better Auth existed, so an older
# ledger can be moved onto a new account. Safe to delete once nobody is still
# carrying one. Also stands in for BETTER_AUTH_SECRET if that is unset.
SESSION_SECRET="change-me-to-something-random"

# Google sign-in. Leave blank and the sign-in page offers email only.
# console.cloud.google.com → Credentials → OAuth client ID → Web application.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sending the six-digit sign-in code. Unset in development and the code is
# printed to the server log instead — a fresh clone can be signed into with no
# accounts to create anywhere. Required in production, where a code in a log is
# a leak. Key from resend.com/api-keys.
RESEND_API_KEY=""
EMAIL_FROM="Tally <onboarding@resend.dev>"

# ── Web push ────────────────────────────────────────────────────────────────
# Lets the weekly briefing reach a phone with the app closed. Leave blank and
# the notification toggle simply never appears — everything else still works.
#
# Generate a pair once and keep them; changing them invalidates every device
# that has already subscribed:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push service can reach if this server misbehaves.
VAPID_SUBJECT="mailto:you@example.com"

# ── Model ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# The chat/agent model. gpt-5.6-luna is the cost-optimised 5.6 tier
# (~$0.20/M input, ~$1.20/M output, 1.05M context) — verified 2026-08-03.
# Swap to gpt-5.6-sol for the frontier tier.
OPENAI_MODEL="gpt-5.6-luna"

# Reasoning-class models only (gpt-5.x / o-series): minimal | low | medium | high
OPENAI_REASONING_EFFORT="low"
OPENAI_MAX_OUTPUT_TOKENS="2000"

# Point at any OpenAI-compatible endpoint to swap providers wholesale —
# Groq, Together, OpenRouter, a local Ollama/vLLM. Leave unset for OpenAI.
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# ── Voice ───────────────────────────────────────────────────────────────────
# pipeline = STT -> text agent -> TTS (cheap, reuses everything)
# realtime = duplex speech-to-speech (lowest latency, billed per audio minute)
VOICE_PROVIDER="pipeline"

# -- pipeline mode --
OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"
# NOTE: gpt-4o-mini-tts is flagged deprecated in the model list but is still
# the TTS model on offer. Check `GET /v1/models` if speech starts 404ing.
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# TTS voices are a different roster from the Realtime voices — "marin" lives
# on Realtime and may not exist here. alloy/coral are safe.
OPENAI_TTS_VOICE="alloy"
# Hint the language of short utterances; cuts latency and misdetection.
# OPENAI_TRANSCRIBE_LANGUAGE="en"
# Client-side endpointing.
PIPELINE_VAD_SILENCE_MS="1200"
PIPELINE_VAD_THRESHOLD="0.015"

# -- realtime mode --
# Billed per AUDIO token (~$32/M in, ~$64/M out on gpt-realtime-2), so the
# mini tier is the demo default. Use gpt-realtime-2.1 for best turn-taking.
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
REALTIME_VOICE="marin"
REALTIME_NOISE_REDUCTION="near_field"
# Raise silence/threshold if the agent cuts you off mid-sentence or starts
# answering its own echo. These defaults were chosen for that failure, not speed.
REALTIME_VAD_THRESHOLD="0.7"
REALTIME_VAD_SILENCE_MS="1500"
REALTIME_VAD_PREFIX_PADDING_MS="400"

# ── Agent behaviour ─────────────────────────────────────────────────────────
# Messages replayed verbatim each turn.
AGENT_HISTORY_WINDOW="20"
# Uncompressed messages that trigger a rolling-summary pass.
AGENT_SUMMARY_THRESHOLD="30"

# ── Defaults for new users ──────────────────────────────────────────────────
DEFAULT_CURRENCY="LKR"
DEFAULT_TIMEZONE="UTC"

# Shared secret for POST /api/insights/generate — the weekly-briefing job.
# That route acts for every user, so it is gated on this rather than a session.
# Must be 16+ chars; the route refuses to run when it is unset.
CRON_SECRET="change-me-to-a-long-random-string"

# Speech-to-text bias. Leave OPENAI_TRANSCRIBE_LANGUAGE unset for a bilingual
# market — pinning one language breaks code-switched sentences like
# "lunch එකට 450 ගියා". OPENAI_TRANSCRIBE_PROMPT overrides the built-in
# Sinhala/Singlish vocabulary hint (lib/voice/vocabulary.ts), which is already
# combined with the user's own category and merchant names at request time.
# OPENAI_TRANSCRIBE_PROMPT=""
