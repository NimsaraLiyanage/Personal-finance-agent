// Personal Finance Agent — data model.
//
// Money is stored as INTEGER MINOR UNITS (cents) everywhere. Floats are never
// used for money: 0.1 + 0.2 !== 0.3 in IEEE-754, and a ledger that drifts by a
// cent per thousand rows is a ledger nobody trusts. The agent tools accept
// decimal amounts from the model and convert at the boundary (lib/money.ts).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema: the CLI reads it from
// `prisma.config.ts` and the runtime gets it through the driver adapter in
// lib/db.ts. One less place for a credential to sit.
datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────────────────────
// Authentication is Better Auth, running in this process against this database.
// It is not a hosted service: `User` sits in the same Postgres as the ledger, so
// every relation below is an ordinary foreign key rather than a join against
// someone else's API — and a finance app in a market where the competition
// advertises "we can't see your data" does not hand identity to a US SaaS.
//
// A visitor still gets an anonymous account and a working ledger before they
// sign in. When they do, the anonymous rows are moved onto the real account
// (lib/auth.ts, `onLinkAccount`); nothing is orphaned and nothing is behind a
// sign-up wall.
//
// Better Auth's own `Account`/`Session`/`Verification` models are mapped to
// `AuthAccount`/`AuthSession`/`AuthVerification` below, because `Account` is
// already taken by the thing a user actually calls an account — their wallet.

model User {
  id String @id @default(cuid())

  // ── Better Auth's required shape ──
  /// Anonymous users get a generated address; it is replaced on sign-in.
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String   @default("")
  image         String?
  /// Set by the anonymous plugin. False once they have really signed in.
  isAnonymous   Boolean  @default(false)
  updatedAt     DateTime @default(now()) @updatedAt

  label     String? // optional display name
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  sessions     AuthSession[]
  authAccounts AuthAccount[]

  transactions   Transaction[]
  budgets        Budget[]
  threads        ChatThread[]
  reminders      Reminder[]
  insights       Insight[]
  categories     Category[]
  categoryRules  CategoryRule[]
  accounts       Account[]
  recurring      Recurring[]

  @@map("users")
}

// Better Auth's own tables. Shape is dictated by the library — the only local
// decision is the names, which are prefixed so `Account` can go on meaning a
// wallet. Mapped back in lib/auth.ts via `modelName`.

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id String @id @default(cuid())

  /// The id this provider knows them by, and which provider it is.
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Unused: this deployment is Google and magic link only, no passwords.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// ── Accounts ────────────────────────────────────────────────────────────────
// Where the money actually sits: cash in a pocket, a bank account, a card, a
// mobile wallet. Two things need this and neither works without it.
//
// A **balance** is the obvious one. A ledger that only records deltas can tell
// you what you spent but never what you have, which is the question people
// actually open the app to answer.
//
// A **transfer** is the subtle one. Taking Rs 5,000 out of an ATM is not
// spending Rs 5,000 — it is the same money in a different pocket. Without
// accounts there is nowhere for it to go, so it gets recorded as an expense and
// then spent a second time when it is used. Every month you visit an ATM, the
// ledger overstates your spending. With accounts it becomes a pair of rows that
// move a balance and count as neither income nor expense.

enum AccountKind {
  cash
  bank
  card
  wallet
}

model Account {
  id     String @id @default(cuid())
  userId String

  name String
  kind AccountKind @default(bank)

  /// Last 4 digits as the bank masks them in its SMS. This is what routes an
  /// imported message to the right card without asking every time.
  last4 String?

  currency String

  /// What was in it when tracking started. A balance is this plus everything
  /// recorded since; without it, every account starts life pretending to be
  /// empty and the number on screen is wrong from day one.
  openingBalanceMinor Int @default(0)

  /// Preselected in forms. Exactly one per user, enforced in code.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  /// Closed accounts keep their history and stop appearing in pickers.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
  @@map("accounts")
}

// ── Categories ──────────────────────────────────────────────────────────────
// Categories belong to the person, not to the codebase.
//
// The single most common complaint about expense trackers is that the
// categories never match how the user actually thinks about money — a fixed
// enum can't hold "kade", "bus eka", or "amma". So the thirteen defaults are
// seeded per user and are theirs to rename, retire, or add to.
//
// `Transaction.category` and `Budget.category` still store the slug as a plain
// string rather than a foreign key. That is deliberate: a category can be
// archived without orphaning years of history, and the ledger stays readable
// even if this table is dropped.

model Category {
  id     String @id @default(cuid())
  userId String

  /// Stable key written onto transactions. Never changes once created.
  slug  String
  /// What the person sees. Renaming touches only this.
  label String

  /// Seeded by us vs. created by them. Only affects what we offer to remove.
  builtIn   Boolean   @default(false)
  sortOrder Int       @default(0)
  /// Retired rather than deleted, so old transactions keep their name.
  archivedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@map("categories")
}

/// A correction the person made, remembered.
///
/// "No, Uber is transport, not other" has to stick — an assistant that needs
/// the same fix every week is worse than one that never guessed. Rules are
/// applied server-side when a transaction is written, so they beat whatever
/// the model decided.
model CategoryRule {
  id     String @id @default(cuid())
  userId String

  /// Lowercased merchant or phrase to match against.
  pattern      String
  categorySlug String

  /// `correction` when learned from the user fixing something, `manual` when set deliberately.
  source String @default("correction")
  /// How often it has fired — cheap signal for which rules are earning their keep.
  hits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@map("category_rules")
}

// ── Ledger ──────────────────────────────────────────────────────────────────

enum TransactionKind {
  expense
  income
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  kind TransactionKind

  /// Always positive, in minor units (cents). `kind` carries the sign.
  amountMinor Int
  currency    String

  merchant String?
  category String
  note     String?

  /// When the money actually moved — not when the row was written. The agent
  /// backdates this from phrases like "yesterday" / "last Friday".
  occurredAt DateTime
  createdAt  DateTime @default(now())

  /// Which surface created it: `chat`, `voice`, `manual`, or `sms`.
  source String @default("chat")

  /// Identity of the source document for imported rows — for SMS, a hash of
  /// the message itself (lib/import/sms.ts). The unique index is what makes
  /// re-pasting an overlapping range safe: the second copy collides instead of
  /// double-counting. NULL for everything typed by hand, and Postgres lets
  /// NULLs repeat, so hand entry is unaffected.
  importKey String?

  /// Which pocket it came out of. Optional: everything logged before accounts
  /// existed has no answer, and inventing one would be a lie about their money.
  accountId String?

  /// The two halves of a transfer share this id.
  ///
  /// Both halves move balances — that is the whole point — but neither counts
  /// as income or expense, because moving your own money is not earning or
  /// spending it. Every aggregate in lib/finance/queries.ts filters on
  /// `transferGroupId: null` for exactly that reason.
  transferGroupId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, importKey])
  @@index([userId, occurredAt])
  @@index([userId, category, occurredAt])
  @@index([userId, accountId])
  @@index([transferGroupId])
  @@map("transactions")
}

// ── Budgets ─────────────────────────────────────────────────────────────────

model Budget {
  id     String @id @default(cuid())
  userId String

  category  String
  /// Monthly ceiling in minor units.
  limitMinor Int
  currency   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

// ── Conversation ────────────────────────────────────────────────────────────

model ChatThread {
  id     String @id @default(cuid())
  userId String

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rolling summary of everything before `summaryThrough`. Keeps the prompt
  /// bounded on long threads without losing early context.
  summary        String?
  summaryThrough DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_threads")
}

enum MessageRole {
  user
  assistant
  tool
}

model ChatMessage {
  id       String @id @default(cuid())
  threadId String

  role    MessageRole
  content String      @db.Text

  /// Populated only for `tool` rows — kept for audit/replay, never replayed
  /// into the model (see lib/agent/graph.ts).
  toolName    String?
  toolPayload Json?

  /// The PendingClientActions this turn produced, parked on its last assistant
  /// row. Without these a replayed conversation shows the agent saying "the
  /// chart is on screen" above no chart — the cards are half the answer, so a
  /// transcript that drops them is not the conversation that happened.
  actions Json?

  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ── Insights ────────────────────────────────────────────────────────────────
// The proactive side of the agent: something it worked out and wants to say
// without being asked. Persisted rather than generated on read, because the
// point is that it was true at a moment in time — a briefing that silently
// rewrites itself every page load is a dashboard, not a briefing.

model Insight {
  id     String @id @default(cuid())
  userId String

  /// `weekly_briefing` today; anomaly and subscription kinds will land here.
  kind String @default("weekly_briefing")

  /// The window it covers.
  periodStart DateTime
  periodEnd   DateTime

  headline String
  body      String @db.Text

  /// The fact sheet the prose was written from. Kept so any number in the text
  /// can be traced back to what produced it — an LLM that writes finance copy
  /// must never be the only record of where a figure came from.
  facts Json?

  /// Idempotency: one briefing per user per window, however often the job runs.
  dedupeKey String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("insights")
}

// ── Recurring charges ───────────────────────────────────────────────────────
// The subscriptions and standing charges someone is paying, whether or not
// they remember agreeing to them.
//
// This is stored rather than recomputed on every read for one reason: the
// interesting facts are about CHANGE. "Netflix went from Rs 1,200 to Rs 1,500"
// and "the gym has not charged you since April" only exist if something
// remembers what was true last time. A pure query over the ledger can tell you
// what is there; it cannot tell you what moved.
//
// Rows are found by lib/finance/recurring.ts and confirmed or dismissed by the
// person — a detected charge is a suggestion, never a fact about their life.

enum RecurringCadence {
  weekly
  monthly
  yearly
}

enum RecurringStatus {
  /// Still being charged.
  active
  /// Known about, deliberately ignored for now.
  paused
  /// They say they have cancelled it. Kept so we don't "discover" it again.
  cancelled
}

model Recurring {
  id     String @id @default(cuid())
  userId String

  /// As it appears on the statement.
  merchant String
  /// Lowercased merchant — the key charges are matched on.
  matchKey String

  /// The most recent amount. Changes here are the point of the whole model.
  amountMinor Int
  currency    String
  category    String

  cadence RecurringCadence @default(monthly)

  /// When it last actually appeared in the ledger.
  lastSeenAt DateTime
  /// When the next one is expected, rolled forward as charges land.
  nextDueAt  DateTime
  /// How many charges we have matched. Stands in for confidence.
  occurrences Int @default(1)

  status RecurringStatus @default(active)
  /// `detected` when we found it, `manual` when they added it.
  source String @default("detected")

  /// The amount before the last change, so a price rise can be said once.
  previousAmountMinor Int?
  priceChangedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per merchant per rhythm. A price change updates this row rather
  /// than creating a second one beside it — otherwise the ledger grows a new
  /// "subscription" every time a price goes up.
  @@unique([userId, matchKey, cadence])
  @@index([userId, status, nextDueAt])
  @@map("recurring")
}

// ── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id     String @id @default(cuid())
  userId String

  title    String
  body     String
  dueAt    DateTime
  category String   @default("general")

  /// Idempotency key so a re-asked question doesn't stack duplicates.
  dedupeKey String?

  firedAt   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, dueAt])
  @@map("reminders")
}
