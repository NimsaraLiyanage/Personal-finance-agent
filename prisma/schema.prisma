// Personal Finance Agent — data model.
//
// Money is stored as INTEGER MINOR UNITS (cents) everywhere. Floats are never
// used for money: 0.1 + 0.2 !== 0.3 in IEEE-754, and a ledger that drifts by a
// cent per thousand rows is a ledger nobody trusts. The agent tools accept
// decimal amounts from the model and convert at the boundary (lib/money.ts).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema: the CLI reads it from
// `prisma.config.ts` and the runtime gets it through the driver adapter in
// lib/db.ts. One less place for a credential to sit.
datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────────────────────
// Deliberately minimal. This is a portfolio demo, so a visitor gets an
// anonymous user row keyed by a signed cookie instead of a full auth stack.
// Swap this for Clerk/Auth.js by replacing lib/session.ts — nothing else in
// the agent layer knows how a user id is obtained.

model User {
  id        String   @id @default(cuid())
  label     String? // optional display name
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  transactions   Transaction[]
  budgets        Budget[]
  threads        ChatThread[]
  reminders      Reminder[]
  insights       Insight[]
  categories     Category[]
  categoryRules  CategoryRule[]

  @@map("users")
}

// ── Categories ──────────────────────────────────────────────────────────────
// Categories belong to the person, not to the codebase.
//
// The single most common complaint about expense trackers is that the
// categories never match how the user actually thinks about money — a fixed
// enum can't hold "kade", "bus eka", or "amma". So the thirteen defaults are
// seeded per user and are theirs to rename, retire, or add to.
//
// `Transaction.category` and `Budget.category` still store the slug as a plain
// string rather than a foreign key. That is deliberate: a category can be
// archived without orphaning years of history, and the ledger stays readable
// even if this table is dropped.

model Category {
  id     String @id @default(cuid())
  userId String

  /// Stable key written onto transactions. Never changes once created.
  slug  String
  /// What the person sees. Renaming touches only this.
  label String

  /// Seeded by us vs. created by them. Only affects what we offer to remove.
  builtIn   Boolean   @default(false)
  sortOrder Int       @default(0)
  /// Retired rather than deleted, so old transactions keep their name.
  archivedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, archivedAt])
  @@map("categories")
}

/// A correction the person made, remembered.
///
/// "No, Uber is transport, not other" has to stick — an assistant that needs
/// the same fix every week is worse than one that never guessed. Rules are
/// applied server-side when a transaction is written, so they beat whatever
/// the model decided.
model CategoryRule {
  id     String @id @default(cuid())
  userId String

  /// Lowercased merchant or phrase to match against.
  pattern      String
  categorySlug String

  /// `correction` when learned from the user fixing something, `manual` when set deliberately.
  source String @default("correction")
  /// How often it has fired — cheap signal for which rules are earning their keep.
  hits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@map("category_rules")
}

// ── Ledger ──────────────────────────────────────────────────────────────────

enum TransactionKind {
  expense
  income
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  kind TransactionKind

  /// Always positive, in minor units (cents). `kind` carries the sign.
  amountMinor Int
  currency    String

  merchant String?
  category String
  note     String?

  /// When the money actually moved — not when the row was written. The agent
  /// backdates this from phrases like "yesterday" / "last Friday".
  occurredAt DateTime
  createdAt  DateTime @default(now())

  /// Which surface created it: `chat`, `voice`, or `manual`.
  source String @default("chat")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, category, occurredAt])
  @@map("transactions")
}

// ── Budgets ─────────────────────────────────────────────────────────────────

model Budget {
  id     String @id @default(cuid())
  userId String

  category  String
  /// Monthly ceiling in minor units.
  limitMinor Int
  currency   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

// ── Conversation ────────────────────────────────────────────────────────────

model ChatThread {
  id     String @id @default(cuid())
  userId String

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rolling summary of everything before `summaryThrough`. Keeps the prompt
  /// bounded on long threads without losing early context.
  summary        String?
  summaryThrough DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_threads")
}

enum MessageRole {
  user
  assistant
  tool
}

model ChatMessage {
  id       String @id @default(cuid())
  threadId String

  role    MessageRole
  content String      @db.Text

  /// Populated only for `tool` rows — kept for audit/replay, never replayed
  /// into the model (see lib/agent/graph.ts).
  toolName    String?
  toolPayload Json?

  /// The PendingClientActions this turn produced, parked on its last assistant
  /// row. Without these a replayed conversation shows the agent saying "the
  /// chart is on screen" above no chart — the cards are half the answer, so a
  /// transcript that drops them is not the conversation that happened.
  actions Json?

  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ── Insights ────────────────────────────────────────────────────────────────
// The proactive side of the agent: something it worked out and wants to say
// without being asked. Persisted rather than generated on read, because the
// point is that it was true at a moment in time — a briefing that silently
// rewrites itself every page load is a dashboard, not a briefing.

model Insight {
  id     String @id @default(cuid())
  userId String

  /// `weekly_briefing` today; anomaly and subscription kinds will land here.
  kind String @default("weekly_briefing")

  /// The window it covers.
  periodStart DateTime
  periodEnd   DateTime

  headline String
  body      String @db.Text

  /// The fact sheet the prose was written from. Kept so any number in the text
  /// can be traced back to what produced it — an LLM that writes finance copy
  /// must never be the only record of where a figure came from.
  facts Json?

  /// Idempotency: one briefing per user per window, however often the job runs.
  dedupeKey String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("insights")
}

// ── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id     String @id @default(cuid())
  userId String

  title    String
  body     String
  dueAt    DateTime
  category String   @default("general")

  /// Idempotency key so a re-asked question doesn't stack duplicates.
  dedupeKey String?

  firedAt   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, dueAt])
  @@map("reminders")
}
